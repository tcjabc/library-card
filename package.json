{
  "name": "library-card",
  "private": true,
  "version": "1.8.3",
  "license": "MIT",
  "type": "module",
  "description": "A kids' reading PWA: QR library cards, home and borrowed books, and reading journeys.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "generate-pwa-assets": "pwa-assets-generator",
    "dev:phone": "vite --mode phone",
    "test": "vitest run",
    "test:relay": "npm test --prefix relay",
    "test:watch": "vitest"
  },
  "dependencies": {
    "barcode-detector": "^3.2.4",
    "idb": "^8.0.4",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zxing-wasm": "3.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
