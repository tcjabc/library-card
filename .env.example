# Copy to .env.local and adjust. Everything here is optional: with no .env file
# the app runs with local (on-device) storage at the site root.
# Never commit .env.local. VITE_* values are baked into the public JS bundle,
# so only put values here that are safe to publish.

# Storage adapter: "local" (IndexedDB on this device). Planned: "supabase", "d1".
VITE_DATA_ADAPTER=local

# Public base path. "/" for local dev or a custom domain;
# "/<repo-name>/" for a GitHub Pages project site.
VITE_BASE=/

# Optional. Raises the anonymous rate limit for the Google Books fallback.
VITE_GOOGLE_BOOKS_API_KEY=

# Supabase (not used yet). The anon key is public by design; protect data with RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
